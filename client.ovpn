cat << 'EOF' > client.ovpn
client
dev tun
proto udp
remote 198.51.100.42 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth SHA256
verb 3

<ca>
-----BEGIN CERTIFICATE-----
MIIDXTCCAkWgAwIBAgIJAJ1v9X8aBCDEMA0GCSqGSIb3DQEBCwUAMEUxCzAJBgNV
BAYTA1VTMRMwEQYDVQQIDApDYWxpZm9ybmlhMRYwFAYDVQQHDA1TYW4gRnJhbmNp
c2NvMQswCQYDVQQKDAJMQTAeFw0yNTEwMTkwMDAwMDBaFw0zNTEwMTkwMDAwMDBa
-----END CERTIFICATE-----
</ca>
EOF

# Example environment variables for server/app.py
# Put them in an env file and load them (or export them in your shell).

# Flask binding (localhost recommended)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Tor SOCKS proxy (host:port)
TOR_SOCKS=127.0.0.1:9050

# Tor ControlPort configuration (host and port)
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051

# Control password if you set one in torrc:
# Example torrc: HashedControlPassword HASHVALUE
# Set TOR_CONTROL_PASSWORD to the cleartext password used when generating the hashed password.
TOR_CONTROL_PASSWORD=

# If you prefer cookie-based auth (Tor writes a control_auth_cookie file), leave TOR_CONTROL_PASSWORD empty
TOR_CONTROL_USE_COOKIE=1

# Upstream IP-checking URL (optional)
IP_CHECK_URL=https://httpbin.org/ip
